DATABASE_URL=postgresql://origo:origo_dev_password@localhost:5437/origo_dev
JWT_SECRET=change_me_generate_with_openssl_rand_base64_32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@origo.local
FRONTEND_URL=http://localhost:3456
PORT=3001
NODE_ENV=development

# Stripe Integration (Referral MVP + Checkout)
# Get your secret key from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_test_key_here
# Get webhook secret from: https://dashboard.stripe.com/webhooks
# Create endpoint: /api/v1/webhooks/stripe listening to invoice.paid
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# Referral coupon: 100% off first month (create in Stripe dashboard or set to "create-on-fly")
# If set to "create-on-fly", API will create coupons dynamically
STRIPE_REFERRAL_COUPON_ID=create-on-fly

# Stripe Price IDs (Checkout Session P0)
# Create subscription prices in Stripe dashboard for each plan + billing cycle
# Format: price_xxxxxxxxxxxxx (starts with price_)
# Start plan (até 15 alunos)
STRIPE_PRICE_START_MONTHLY=price_1234567890abcdef_start_monthly
STRIPE_PRICE_START_ANNUAL=price_1234567890abcdef_start_annual
# Pro plan (alunos ilimitados)
STRIPE_PRICE_PRO_MONTHLY=price_1234567890abcdef_pro_monthly
STRIPE_PRICE_PRO_ANNUAL=price_1234567890abcdef_pro_annual
# Clinic plan (até 3 seats)
STRIPE_PRICE_CLINIC_MONTHLY=price_1234567890abcdef_clinic_monthly
STRIPE_PRICE_CLINIC_ANNUAL=price_1234567890abcdef_clinic_annual

# Frontend Settings
NEXT_PUBLIC_BILLING_LIVE=false
