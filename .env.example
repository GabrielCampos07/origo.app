DATABASE_URL=postgresql://origo:origo_dev_password@localhost:5435/origo_dev
JWT_SECRET=change_me_generate_with_openssl_rand_base64_32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@origo.local
FRONTEND_URL=http://localhost:3456
PORT=3001
NODE_ENV=development

# Stripe Integration (Referral MVP)
# Get your secret key from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_test_key_here
# Get webhook secret from: https://dashboard.stripe.com/webhooks
# Create endpoint: /api/v1/webhooks/stripe listening to invoice.paid
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# Referral coupon: 100% off first month (create in Stripe dashboard or set to "create-on-fly")
# If set to "create-on-fly", API will create coupons dynamically
STRIPE_REFERRAL_COUPON_ID=create-on-fly

# Frontend Settings
NEXT_PUBLIC_BILLING_LIVE=false
