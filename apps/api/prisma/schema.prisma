// Prisma 6 schema for Origo
// NOTA: Este é apenas um stub de infraestrutura (W0.4/W0.5)
// Login, forgot-password e demais features são de responsabilidade do squad BACKEND (D1–D4)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, pgcrypto]
}

// UserRole enum for MVP session role-aware authorization
// DATABASE SECURITY NOTES:
// - role is an authorization attribute, NOT PII
// - Least privilege unchanged: application logic controls access based on role
// - No new PII columns introduced in this change
enum UserRole {
  PROFESSIONAL
  STUDENT
}

// Professional category enum for Bloco A (MVP)
// Defines professional specializations in Origo system
enum ProfessionalCategory {
  FISIOTERAPIA
  EDUCACAO_FISICA
  PERSONAL
}

// Enrollment status enum for Bloco A
// Tracks student-professional enrollment lifecycle
enum EnrollmentStatus {
  ACTIVE
  REVOKED
}

// P0 Auth Schema
// Tokens armazenados APENAS como hash (SHA-256)
// Purge D8: expired/used reset tokens devem ser removidos via job batch (cron diário recomendado)
model User {
  id           String   @id @default(cuid())
  email        String   @unique @db.Citext
  passwordHash String
  name         String?
  role         UserRole @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  passwordResetTokens       PasswordResetToken[]
  refreshTokens             RefreshToken[]
  legalAcceptances          LegalAcceptance[]
  referralCode              ReferralCode?
  referralsAsReferrer       Referral[]             @relation("ReferralReferrer")
  referralAsReferred        Referral?              @relation("ReferralReferred")
  professionalProfile       ProfessionalProfile?
  inviteTokensCreated       InviteToken[]
  enrollmentsAsStudent      Enrollment[]           @relation("EnrollmentStudent")
  enrollmentsAsProfessional Enrollment[]           @relation("EnrollmentProfessional")

  @@map("users")
}

// Password reset tokens (hash-only, single-use)
// D8 purge: WHERE expiresAt < NOW() OR usedAt IS NOT NULL
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// Refresh tokens (hash-only, revocable)
// D8 purge: WHERE expiresAt < NOW() OR revokedAt IS NOT NULL
model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// Legal V2: User acceptance records for legal documents (LGPD compliance)
// 
// DATABASE SECURITY - LGPD Article 7 Consent Proof:
// PURPOSE LIMITATION: Records exist ONLY as proof of legal document acceptance
// MINIMAL PII: userId + docVersion + acceptedAt (no IP, User-Agent, or session data)
// IMMUTABILITY: APPEND-ONLY - never UPDATE acceptedAt or DELETE individual rows
//   - New acceptance = new row with new docVersion
//   - No soft-delete of acceptance records
//   - Purge only via full User CASCADE delete or legal/compliance directive
// RETENTION: TBD - coordinate with legal/compliance team for retention policy
// ACCESS CONTROL: API database role should have INSERT + SELECT only (no UPDATE/DELETE)
// 
// DOC VERSION FORMAT (SoT aligned with Front/OWNER):
//   Examples: privacy_v2_2026-09-13, terms_app_v2_2026-09-13,
//             terms_saas_v2_2026-09-13, payments_notice_v2_2026-09-13
// 
// GATE LOGIC (enforced in API, stored generically here):
//   - All users: privacy_v2_*, terms_app_v2_*
//   - PROFESSIONAL/Checkout: also terms_saas_v2_*, payments_notice_v2_*
model LegalAcceptance {
  id         String   @id @default(cuid())
  userId     String
  docVersion String
  acceptedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, docVersion])
  @@index([userId])
  @@index([userId, acceptedAt])
  @@map("legal_acceptances")
}

// MVP Referral Schema
// Purpose: Track referral attribution and rewards (15% payout + 1-month free coupon)
// Security: userId fields are PII-linked; purpose = referral attribution/rewards only
// No card/PIX/bank data stored; Stripe IDs are opaque external references
// Least privilege: API INSERT/SELECT; payout ledger is append-only
// CASCADE: referral_codes deletion cascades to referrals; referrals cascade to payouts
// Retention: TBD by compliance team

// Referral codes (1 per user, typically PROFESSIONAL role)
model ReferralCode {
  id        String     @id @default(cuid())
  userId    String     @unique
  code      String     @unique @db.Citext
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals Referral[]

  @@map("referral_codes")
}

// Referral attribution (1 referrer per referred user)
// stripeCouponId: tracks 1-month free coupon for referred user
// freeMonthEndsAt: expiry timestamp for free month benefit
enum ReferralStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

model Referral {
  id               String          @id @default(cuid())
  referrerUserId   String
  referredUserId   String          @unique
  referralCodeId   String
  stripeCouponId   String?
  freeMonthEndsAt  DateTime?
  status           ReferralStatus  @default(PENDING)
  createdAt        DateTime        @default(now())
  referrer         User            @relation("ReferralReferrer", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referred         User            @relation("ReferralReferred", fields: [referredUserId], references: [id], onDelete: Cascade)
  referralCode     ReferralCode    @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  payouts          ReferralPayout[]

  @@index([referrerUserId])
  @@index([referralCodeId])
  @@map("referrals")
}

// Append-only payout ledger (NO updates in app layer)
// commissionRateBps: 1500 = 15.00% commission rate
model ReferralPayout {
  id                 String   @id @default(cuid())
  referralId         String
  stripeInvoiceId    String   @unique
  amountCents        Int
  currency           String   @default("brl")
  commissionRateBps  Int      @default(1500)
  createdAt          DateTime @default(now())
  referral           Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@index([referralId])
  @@map("referral_payouts")
}

// Bloco A: Professional Profile
// DATABASE SECURITY NOTES:
// - PURPOSE: Professional specialization tracking for enrollment system
// - PII: userId (linked to User), category is classification metadata
// - LEAST PRIVILEGE: api_app_role has SELECT+INSERT+UPDATE (no DELETE)
// - CASCADE: Deletion via User CASCADE or compliance directive only
model ProfessionalProfile {
  id        String                @id @default(cuid())
  userId    String                @unique
  category  ProfessionalCategory
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("professional_profiles")
}

// Bloco A: Invite Token (hash-only, similar to PasswordResetToken)
// DATABASE SECURITY NOTES:
// - PURPOSE: Single-use enrollment invite tokens
// - SECURITY: Store SHA-256 hash ONLY, never plaintext token
// - SINGLE-USE: usedAt marks token as consumed (cannot be reused)
// - PURGE: D8-style batch job should remove expired/used tokens
// - PII: professionalUserId (linked to User creating invite)
// - LEAST PRIVILEGE: api_app_role has SELECT+INSERT+UPDATE (no DELETE; purge elevated)
model InviteToken {
  id                   String                @id @default(cuid())
  tokenHash            String                @unique
  professionalUserId   String
  category             ProfessionalCategory
  expiresAt            DateTime
  usedAt               DateTime?
  createdAt            DateTime              @default(now())
  professional         User                  @relation(fields: [professionalUserId], references: [id], onDelete: Cascade)

  @@index([professionalUserId])
  @@index([expiresAt])
  @@map("invite_tokens")
}

// Bloco A: Enrollment (student-professional relationship)
// DATABASE SECURITY NOTES:
// - PURPOSE: Care relationship tracking (student enrolled with professional)
// - PII: studentUserId + professionalUserId (linked to Users)
// - DATA INTEGRITY: Partial unique index enforces ONE ACTIVE per (studentUserId, category)
// - DATA INTEGRITY: CHECK constraint prevents self-enrollment (studentUserId <> professionalUserId)
// - LIFECYCLE: ACTIVE → REVOKED (endedAt set); switch enrollment = REVOKED old + new ACTIVE
// - LEAST PRIVILEGE: api_app_role has SELECT+INSERT+UPDATE (no DELETE)
// - NO CLINICAL DATA: This table tracks relationship only, not session logs or HEP
model Enrollment {
  id                   String                @id @default(cuid())
  studentUserId        String
  professionalUserId   String
  category             ProfessionalCategory
  status               EnrollmentStatus      @default(ACTIVE)
  startedAt            DateTime              @default(now())
  endedAt              DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  student              User                  @relation("EnrollmentStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
  professional         User                  @relation("EnrollmentProfessional", fields: [professionalUserId], references: [id], onDelete: Cascade)

  @@index([studentUserId])
  @@index([professionalUserId])
  @@index([category])
  @@map("enrollments")
}
