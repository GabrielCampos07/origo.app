// Prisma 6 schema for Origo
// NOTA: Este é apenas um stub de infraestrutura (W0.4/W0.5)
// Login, forgot-password e demais features são de responsabilidade do squad BACKEND (D1–D4)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, pgcrypto]
}

// P0 Auth Schema
// Tokens armazenados APENAS como hash (SHA-256)
// Purge D8: expired/used reset tokens devem ser removidos via job batch (cron diário recomendado)
model User {
  id           String   @id @default(cuid())
  email        String   @unique @db.Citext
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]
  legalAcceptances    LegalAcceptance[]

  @@map("users")
}

// Password reset tokens (hash-only, single-use)
// D8 purge: WHERE expiresAt < NOW() OR usedAt IS NOT NULL
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// Refresh tokens (hash-only, revocable)
// D8 purge: WHERE expiresAt < NOW() OR revokedAt IS NOT NULL
model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// Legal V2: User acceptance records for legal documents (LGPD compliance)
// PURPOSE: Legal consent proof for privacy policy, terms of service, payment notices
// PERSONAL DATA: userId+docVersion+acceptedAt constitutes personal data processing record
// RETENTION: TBD - coordinate with legal/compliance team
// GATE LOGIC (enforced in API, stored generically here):
//   - All users: privacy@YYYY-MM-DD, terms_app@YYYY-MM-DD
//   - PROFESSIONAL/Checkout: also terms_saas@YYYY-MM-DD, payments_notice@YYYY-MM-DD
// NOTE: User deletion strategy (soft-delete vs CASCADE) TBD; CASCADE acceptable for P0
model LegalAcceptance {
  id         String   @id @default(cuid())
  userId     String
  docVersion String
  acceptedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, docVersion])
  @@index([userId])
  @@index([userId, acceptedAt])
  @@map("legal_acceptances")
}
