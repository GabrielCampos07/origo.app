// Prisma 6 schema for Origo
// NOTA: Este é apenas um stub de infraestrutura (W0.4/W0.5)
// Login, forgot-password e demais features são de responsabilidade do squad BACKEND (D1–D4)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, pgcrypto]
}

// P0 Auth Schema
// Tokens armazenados APENAS como hash (SHA-256)
// Purge D8: expired/used reset tokens devem ser removidos via job batch (cron diário recomendado)
model User {
  id           String   @id @default(cuid())
  email        String   @unique @db.Citext
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]
  legalAcceptances    LegalAcceptance[]

  @@map("users")
}

// Password reset tokens (hash-only, single-use)
// D8 purge: WHERE expiresAt < NOW() OR usedAt IS NOT NULL
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// Refresh tokens (hash-only, revocable)
// D8 purge: WHERE expiresAt < NOW() OR revokedAt IS NOT NULL
model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// Legal V2: User acceptance records for legal documents (LGPD compliance)
// 
// DATABASE SECURITY - LGPD Article 7 Consent Proof:
// PURPOSE LIMITATION: Records exist ONLY as proof of legal document acceptance
// MINIMAL PII: userId + docVersion + acceptedAt (no IP, User-Agent, or session data)
// IMMUTABILITY: APPEND-ONLY - never UPDATE acceptedAt or DELETE individual rows
//   - New acceptance = new row with new docVersion
//   - No soft-delete of acceptance records
//   - Purge only via full User CASCADE delete or legal/compliance directive
// RETENTION: TBD - coordinate with legal/compliance team for retention policy
// ACCESS CONTROL: API database role should have INSERT + SELECT only (no UPDATE/DELETE)
// 
// DOC VERSION FORMAT (SoT aligned with Front/OWNER):
//   Examples: privacy_v2_2026-09-13, terms_app_v2_2026-09-13,
//             terms_saas_v2_2026-09-13, payments_notice_v2_2026-09-13
// 
// GATE LOGIC (enforced in API, stored generically here):
//   - All users: privacy_v2_*, terms_app_v2_*
//   - PROFESSIONAL/Checkout: also terms_saas_v2_*, payments_notice_v2_*
model LegalAcceptance {
  id         String   @id @default(cuid())
  userId     String
  docVersion String
  acceptedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, docVersion])
  @@index([userId])
  @@index([userId, acceptedAt])
  @@map("legal_acceptances")
}
