{
  "name": "@origo/api",
  "version": "0.1.0",
  "private": true,
  "description": "Origo API (Fastify 5)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test node --env-file=.env --import tsx --test --test-force-exit src/routes/hep.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/env": "^5.0.1",
    "@fastify/rate-limit": "^11.2.0",
    "@prisma/client": "^6.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.1",
    "argon2": "^0.45.1",
    "fastify": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.8",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prisma": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
